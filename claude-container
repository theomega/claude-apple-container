#!/usr/bin/env bash
#
# claude-container — run Claude Code isolated inside an Apple Container.
#
# The project root is the ONLY host path mounted into the container
# (writable, at the same absolute path). It is determined as follows:
# a Dockerfile.dev in the current folder makes the current folder the
# project (narrow scope); otherwise a Dockerfile.dev at the git root of the
# current repo makes the whole repo the project; otherwise the current
# folder is the project, built from Dockerfile.default next to this script.
# The image is rebuilt automatically whenever the Dockerfile changes.
# Containers are session-scoped: claude is the container's main process and
# the container is removed when the session ends.
#
# Usage:
#   claude-container [--safe] [claude args...]   start a claude session
#   claude-container shell                       open a shell in the image instead
#   claude-container stop [--all]                stop this project's sessions (or every project's)
#   claude-container ls                          list running claude-container sessions
#   claude-container rebuild [claude args...]    rebuild image (--no-cache), then start a session
#   claude-container help
#
# Claude runs with --dangerously-skip-permissions by default (the container
# provides the isolation); pass --safe for normal permission prompts.
# Arguments after `--` are always passed to claude verbatim.
#
# Environment:
#   ANTHROPIC_API_KEY   forwarded into the container if set; otherwise run
#                       /login once per project (persists in the state dir)
#   TERM                forwarded into the container if set
#   ~/.config/claude-container/env
#                       optional env file (KEY=value lines) passed to the
#                       container via --env-file
#   ~/.config/claude-container/managed-settings.json
#                       optional; mounted read-only at claude's managed-
#                       settings path (/etc/claude-code/managed-settings.json)
#   ~/.config/claude-container/share/
#                       optional; entries mounted read-only under
#                       /opt/claude-container in every container
#                       (symlinks are resolved on the host first)
#   <project root>/claude-container.args
#                       optional; extra `container run` arguments, one per
#                       line (blank lines and # comments ignored)
#   CC_MEMORY           container memory (default: 8g)
#   CC_CPUS             container CPUs (default: 4)
#   CC_DOCKERFILE       explicit Dockerfile path, skips discovery

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

: "${CC_MEMORY:=8g}"
: "${CC_CPUS:=4}"

CONFIG_DIR="$HOME/.config/claude-container"
ENV_FILE="$CONFIG_DIR/env"

die() { echo "claude-container: $*" >&2; exit 1; }
# Print the header comment (everything up to the first non-comment line).
usage() { awk 'NR < 3 {next} !/^#/ {exit} {sub(/^# ?/, ""); print}' "${BASH_SOURCE[0]}"; }

# ---- locate Dockerfile ------------------------------------------------------
# 1. Dockerfile.dev in $PWD          -> project = $PWD (narrow scope)
# 2. Dockerfile.dev at the git root  -> project = the whole repo
# 3. neither                         -> Dockerfile.default, project = $PWD
# The project root is what gets mounted (writable) and defines the image,
# session, and claude-state identity.
root=$PWD
if [[ -n ${CC_DOCKERFILE:-} ]]; then
  dockerfile=$CC_DOCKERFILE
  [[ -f $dockerfile ]] || die "CC_DOCKERFILE not found: $dockerfile"
elif [[ -f $PWD/Dockerfile.dev ]]; then
  dockerfile=$PWD/Dockerfile.dev
else
  git_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n $git_root && -f $git_root/Dockerfile.dev ]]; then
    dockerfile=$git_root/Dockerfile.dev
    root=$git_root
  else
    dockerfile=$SCRIPT_DIR/Dockerfile.default
    [[ -f $dockerfile ]] || die "no Dockerfile.dev in $PWD or at the git root, and no $dockerfile"
  fi
fi

# ---- project identity (from the project root) -------------------------------
path_hash=$(printf '%s' "$root" | shasum -a 256 | cut -c1-8)
project=$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
project=${project#-}; project=${project%-}
prefix="claude-${project}-${path_hash}"
image_repo="claude-dev-${project}-${path_hash}"

ensure_runtime() {
  container system status >/dev/null 2>&1 || {
    echo "starting container runtime..." >&2
    container system start
  }
}

running_sessions() {
  container ls -q 2>/dev/null | grep "^${1}" || true
}

# ---- subcommands ------------------------------------------------------------
cmd_ls() {
  ensure_runtime
  local sessions
  sessions=$(running_sessions "claude-")
  if [[ -z $sessions ]]; then
    echo "no claude-container sessions running"
    return 0
  fi
  container ls | { IFS= read -r header; echo "$header"; grep "^claude-"; }
}

cmd_stop() {
  ensure_runtime
  local scope=$prefix
  [[ ${1:-} == --all ]] && scope="claude-"
  local sessions
  sessions=$(running_sessions "$scope")
  if [[ -z $sessions ]]; then
    if [[ $scope == claude- ]]; then
      echo "no claude-container sessions running"
    else
      echo "no sessions running for $root"
    fi
    return 0
  fi
  # shellcheck disable=SC2086
  container stop $sessions
  echo "stopped:" $sessions
}

# ---- default action: build if needed, then run ------------------------------
mode=run rebuild=0 safe=0 shell_mode=0
claude_args=()

case "${1:-}" in
  shell)      shell_mode=1; shift ;;
  stop)       shift; cmd_stop "${1:-}"; exit ;;
  ls|list)    cmd_ls; exit ;;
  rebuild)    rebuild=1; shift ;;
  help|-h|--help) usage; exit 0 ;;
esac

while (($#)); do
  case "$1" in
    --safe) safe=1 ;;
    --)     shift; claude_args+=("$@"); break ;;
    *)      claude_args+=("$1") ;;
  esac
  shift
done

# ---- claude state dir --------------------------------------------------------
# A per-project host dir is mounted as CLAUDE_CONFIG_DIR, so claude's state
# survives the ephemeral containers: first-run prompts (onboarding, folder
# trust, API key approval, bypass-permissions warning) only need to be
# answered once per project, and `claude --resume` sees earlier sessions.
state_dir="$HOME/.cache/claude-container/$prefix"
mkdir -p "$state_dir"

ensure_runtime

# ---- build when the Dockerfile changed (or first run / rebuild) --------------
# The image tag is the Dockerfile's content hash: a fresh start is a single
# 'image inspect' call, and any edit to the Dockerfile produces a new tag.
df_hash=$(shasum -a 256 "$dockerfile" | cut -c1-12)
image="${image_repo}:${df_hash}"

if ((rebuild)) || ! container image inspect "$image" >/dev/null 2>&1; then
  echo "building $image from ${dockerfile/#"$root"\//} ..." >&2
  build_flags=(-f "$dockerfile" -t "$image")
  ((rebuild)) && build_flags+=(--no-cache)
  container build "${build_flags[@]}" "$root"

  # Drop this project's images for older Dockerfile versions.
  stale=$(container image ls | awk -v repo="$image_repo" -v tag="$df_hash" \
    '$1 == repo && $2 != tag {print $1":"$2}')
  if [[ -n $stale ]]; then
    # shellcheck disable=SC2086
    container image delete $stale >/dev/null
  fi

  # Sessions started before the rebuild still run the old image.
  old_sessions=$(running_sessions "$prefix-")
  if [[ -n $old_sessions ]]; then
    echo "note: sessions from before this rebuild are still running" \
         "('claude-container stop' to end them):" $old_sessions >&2
  fi
fi

# ---- run --------------------------------------------------------------------
session="${prefix}-$$"

run_args=(
  --rm -i
  --name "$session"
  # Minimal init as PID 1: reaps orphaned processes (claude never waits on
  # reparented children, so they would pile up as zombies) and forwards signals.
  --init
  --memory "$CC_MEMORY" --cpus "$CC_CPUS"
  # The project root is the only host data mount, at its host path.
  -v "$root:$root"
  -w "$PWD"
  # Per-project claude state (pre-accepted prompts, session history).
  -v "$state_dir:/claude-config"
  -e CLAUDE_CONFIG_DIR=/claude-config
  # Allows --dangerously-skip-permissions to run as root in the container.
  -e IS_SANDBOX=1
)
[[ -t 0 && -t 1 ]] && run_args+=(-t)
# Forward the host terminal type so claude sees the terminal's real
# capabilities (the runtime would default to plain TERM=xterm).
[[ -n ${TERM:-} ]] && run_args+=(-e "TERM=$TERM")
[[ -n ${ANTHROPIC_API_KEY:-} ]] && run_args+=(-e ANTHROPIC_API_KEY)
[[ -f $ENV_FILE ]] && run_args+=(--env-file "$ENV_FILE")

# User customizations shared by all containers (both optional, read-only):
# managed settings at claude's fixed path, and a free-form share dir whose
# top-level entries land under /opt/claude-container. Entries are mounted
# individually with host symlinks resolved, so they may be symlinks into
# e.g. a dotfiles repo.
if [[ -f $CONFIG_DIR/managed-settings.json ]]; then
  run_args+=(-v "$(readlink -f "$CONFIG_DIR/managed-settings.json"):/etc/claude-code/managed-settings.json:ro")
fi
for f in "$CONFIG_DIR"/share/*; do
  [[ -e $f ]] || continue
  run_args+=(-v "$(readlink -f "$f"):/opt/claude-container/${f##*/}:ro")
done

# Forward git identity so commits made inside the container are attributed.
git_name=$(git config user.name 2>/dev/null || true)
git_email=$(git config user.email 2>/dev/null || true)
[[ -n $git_name ]]  && run_args+=(-e "GIT_AUTHOR_NAME=$git_name"  -e "GIT_COMMITTER_NAME=$git_name")
[[ -n $git_email ]] && run_args+=(-e "GIT_AUTHOR_EMAIL=$git_email" -e "GIT_COMMITTER_EMAIL=$git_email")

# Per-project extra `container run` arguments (optional): one argument per
# line, so no shell quoting is involved; blank lines and # comments are
# ignored. Appended last so they can override the defaults above.
args_file="$root/claude-container.args"
if [[ -f $args_file ]]; then
  while IFS=$' \t\r' read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    run_args+=("$line")
  done <"$args_file"
fi

if ((shell_mode)); then
  cmd=(bash)
else
  cmd=(claude)
  ((safe)) || cmd+=(--dangerously-skip-permissions)
  cmd+=("${claude_args[@]+"${claude_args[@]}"}")
fi

exec container run "${run_args[@]}" "$image" "${cmd[@]}"
